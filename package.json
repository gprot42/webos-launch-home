{
  "name": "webos-launch-home",
  "version": "0.0.1",
  "description": "Launch Home — fullscreen home screen for rooted LG webOS TVs",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "pack": "node scripts/build.js --pack",
    "verify-ipk": "node scripts/verify-ipk.js",
    "clean": "rm -rf dist",
    "update:aerials": "node --use-system-ca scripts/update-aerials.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@procot/webostv": "^1.2.6",
    "@webos-tools/cli": "^3.2.6",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
